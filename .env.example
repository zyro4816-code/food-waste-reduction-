# =============================================================================
# SAVEPLATE ENVIRONMENT CONFIGURATION
# =============================================================================

PORT=5000
NODE_ENV=development

# Database configuration
# Set DB_CLIENT=mysql to connect to your local or remote MySQL server
# Set DB_CLIENT=sqlite for instant zero-config embedded SQLite
DB_CLIENT=sqlite

# MySQL Connection Details (Used when DB_CLIENT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saveplate_db

# Security & Authentication
JWT_SECRET=saveplate_super_secret_jwt_key_2026_food_waste_reduction_system
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by server/scripts/create-admin.js)
ADMIN_EMAIL=admin@saveplate.org
ADMIN_PASSWORD=Admin@SavePlate2026!
ADMIN_NAME=SavePlate Administrator

# Uploads Configuration
UPLOAD_MAX_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

